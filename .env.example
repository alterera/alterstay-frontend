NEXT_PUBLIC_API_URL=http://localhost:3001
# Hostname of the public MinIO AIStor media domain (no protocol). Required for
# production builds; next/image only loads property images from this host over HTTPS.
NEXT_PUBLIC_MEDIA_HOST=media.alterstay.in
# Optional override when the API does not return cashfreeMode (defaults to production).
# NEXT_PUBLIC_CASHFREE_MODE=production
